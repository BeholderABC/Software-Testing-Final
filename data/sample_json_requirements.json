{"requirements":
  [
   {
    "requirement_id": "R1",
    "feature": "User registration",
    "inputs": ["username"],
    "constraints":
    [
     {
      "field": "username",
      "type": "unique"
     }
    ],
    "conditions": ["username submitted"],
"expected_behavior": ["system rejects duplicate username"]},
{"requirement_id": "R2",
"feature": "User registration",
"inputs": ["password"],
"constraints": [{"field": "password",
"type": "length",
"min": 8,
"max": 20}],
"conditions": ["password submitted"],
"expected_behavior": ["system rejects password shorter than 8 or longer than 20 characters"]},
{"requirement_id": "R3",
"feature": "User registration",
"inputs": ["password"],
"constraints": [{"field": "password",
"type": "character_set",
"required": ["uppercase",
"lowercase",
"digit"]}],
"conditions": ["password submitted"],
"expected_behavior": ["system rejects password missing uppercase, lowercase, or digit"]}]}